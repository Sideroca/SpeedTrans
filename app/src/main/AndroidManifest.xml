<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:theme="@style/Theme.App">

        <!-- 桌面入口由 activity-alias 承担（支持图标/名称预设切换） -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity android:name=".SettingsActivity" android:exported="false" />

        <activity
            android:name=".AuthorizeActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent" />

        <activity-alias
            android:name=".main_red"
            android:targetActivity=".MainActivity"
            android:label="@string/app_name"
            android:icon="@drawable/ic_app"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".main_blue"
            android:targetActivity=".MainActivity"
            android:label="备忘录"
            android:icon="@drawable/ic_app_blue"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".main_green"
            android:targetActivity=".MainActivity"
            android:label="工具箱"
            android:icon="@drawable/ic_app_green"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 可选引擎：无障碍取词 -->
        <service
            android:name=".service.BallService"
            android:exported="false"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 默认引擎：OCR 屏幕捕捉 + 前台保活 + 悬浮球 -->
        <service
            android:name=".service.ScreenBallService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
