<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 闪译 SpeedTrans"
            android:textColor="#222222"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="点一下悬浮球 → 立即流式翻译屏幕文字（英→中）"
            android:textColor="#777777"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCapture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvApi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="① 去开启悬浮窗权限" />

        <Button
            android:id="@+id/btnCapture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="📸 授权屏幕捕捉" />

        <Button
            android:id="@+id/btnA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="② 无障碍设置" />

        <Button
            android:id="@+id/btnApi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="③ 配置翻译接口与外观" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:text="使用方法：\n· 单击悬浮球 = 截屏取词，立即流式翻译\n· 翻译中再点球 = 用最新屏幕内容重新翻译\n· 按住拖动 = 移动悬浮球\n· 内容没变时点球 = 秒回，不发请求\n· 持续增长的内容（如模型思考）：自动增量翻译\n\n引擎说明：\n· OCR 引擎（默认）：屏幕捕捉授权一次长期有效，权限温和，可识别图片文字\n· 无障碍引擎（可选）：设置里切换，可抓取折叠面板全文，但 MIUI 会弹「危险」确认且易被杀\n\n小米/MIUI 防杀后台（一次性设置）：\n1. 最近任务长按本应用卡片 → 锁定\n2. 应用详情 → 省电策略 → 无限制\n3. 应用详情 → 自启动 → 开启\n\n日常无需打开本应用，点球即用。"
            android:textColor="#555555"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
