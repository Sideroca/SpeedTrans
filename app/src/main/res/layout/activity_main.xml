<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMainHost"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 页面壁纸：纯装饰底层，零交互 -->
    <ImageView
        android:id="@+id/ivWallpaperMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/wpScrimMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 底部渐变桥：背景渐隐融进导航栏收口色（消除色层分界） -->
    <View
        android:id="@+id/vwNavBridgeMain"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="bottom"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/rootMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/homeCol"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="6dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <!-- ======== 头部：标题 + 副标题 + 头像/换头像螺母 ======== -->
            <LinearLayout
                android:id="@+id/headRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivBolt"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_bolt" />

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="闪译 SpeedTrans"
                            android:textSize="21sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="点一下悬浮球 → 立即流式翻译屏幕文字（英→中）"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:contentDescription="头像（长按恢复默认）" />

                    <ImageView
                        android:id="@+id/btnAvatarEdit"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="-13dp"
                        android:layout_marginEnd="-14dp"
                        android:contentDescription="更换头像"
                        android:padding="14dp"
                        android:src="@drawable/ic_home_nut" />
                </LinearLayout>
            </LinearLayout>

            <!-- ======== 卡片1：主题色 ======== -->
            <LinearLayout
                android:id="@+id/cardTheme"
                style="@style/HomeCard">

                <LinearLayout
                    android:id="@+id/headTheme"
                    style="@style/HomeCardHead">

                    <FrameLayout
                        android:id="@+id/chip_theme"
                        style="@style/HomeChipIcon">

                        <ImageView
                            android:id="@+id/ic_theme"
                            style="@style/HomeChipGlyph"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_palette" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvThemeTitle"
                            style="@style/HomeCardTitle"
                            android:text="主题色" />

                        <TextView
                            android:id="@+id/tvThemeSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="选择你喜欢的主题颜色"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/chevTheme"
                        style="@style/HomeChev"
                        android:contentDescription="打开主题设置"
                        android:src="@drawable/ic_home_chev"
                        android:tag="chev" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/quickThemeRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ======== 卡片2：运行状态 ======== -->
            <LinearLayout
                android:id="@+id/cardStatus"
                style="@style/HomeCard">

                <LinearLayout style="@style/HomeCardHead">

                    <FrameLayout
                        android:id="@+id/chip_status"
                        style="@style/HomeChipIcon">

                        <ImageView
                            android:id="@+id/ic_status"
                            style="@style/HomeChipGlyph"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_pulse" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        style="@style/HomeCardTitle"
                        android:layout_marginStart="10dp"
                        android:text="运行状态" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvStatusAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="所有服务正常运行"
                        android:textSize="10.5sp" />

                    <View
                        android:id="@+id/ivStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="5dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/statusPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp">

                <!-- 行1：悬浮窗权限（点击 = 去开启悬浮窗） -->
                <LinearLayout
                    android:id="@+id/rowOverlay"
                    style="@style/HomeRow">

                    <FrameLayout
                        android:id="@+id/chip_ovl"
                        style="@style/HomeChipIcon">

                        <ImageView
                            android:id="@+id/ic_ovl"
                            style="@style/HomeChipGlyph"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_bolt" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOvlTitle"
                            style="@style/HomeRowTitle"
                            android:text="悬浮窗权限" />

                        <TextView
                            android:id="@+id/tvOvlSub"
                            style="@style/HomeRowSub"
                            android:text="允许在屏幕上显示悬浮球" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOvlChip"
                        style="@style/HomeChip"
                        android:text="已开启" />

                    <ImageView
                        style="@style/HomeChev"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_chev"
                        android:tag="chev" />
                </LinearLayout>

                <View
                    android:id="@+id/divStatus1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="45dp" />

                <!-- 行2：无障碍服务（点击 = 无障碍设置） -->
                <LinearLayout
                    android:id="@+id/rowA11y"
                    style="@style/HomeRow">

                    <FrameLayout
                        android:id="@+id/chip_a11"
                        style="@style/HomeChipIcon">

                        <ImageView
                            android:id="@+id/ic_a11"
                            style="@style/HomeChipGlyph"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_person" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvA11Title"
                            style="@style/HomeRowTitle"
                            android:text="无障碍服务" />

                        <TextView
                            android:id="@+id/tvA11Sub"
                            style="@style/HomeRowSub"
                            android:text="用于识别屏幕内容和操作" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvA11Chip"
                        style="@style/HomeChip"
                        android:text="运行中" />

                    <ImageView
                        style="@style/HomeChev"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_chev"
                        android:tag="chev" />
                </LinearLayout>

                <View
                    android:id="@+id/divStatus2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="45dp" />

                <!-- 行3：翻译接口（点击 = 接口设置） -->
                <LinearLayout
                    android:id="@+id/rowApi"
                    style="@style/HomeRow">

                    <FrameLayout
                        android:id="@+id/chip_api"
                        style="@style/HomeChipIcon">

                        <ImageView
                            android:id="@+id/ic_api"
                            style="@style/HomeChipGlyph"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_blocks" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvApiTitle"
                            style="@style/HomeRowTitle"
                            android:text="智能接口" />

                        <TextView
                            android:id="@+id/tvApiSub"
                            style="@style/HomeRowSub"
                            android:text="尚未配置，点击去设置" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvApiChip"
                        style="@style/HomeChip"
                        android:text="未配置" />

                    <ImageView
                        style="@style/HomeChev"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_chev"
                        android:tag="chev" />
                </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ======== 卡片3：设置与工具 ======== -->
            <LinearLayout
                android:id="@+id/cardTools"
                style="@style/HomeCard">

                <LinearLayout style="@style/HomeCardHead">

                    <FrameLayout
                        android:id="@+id/chip_tools"
                        style="@style/HomeChipIcon">

                        <ImageView
                            android:id="@+id/ic_tools"
                            style="@style/HomeChipGlyph"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_nut" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvToolsTitle"
                        style="@style/HomeCardTitle"
                        android:layout_marginStart="10dp"
                        android:text="设置与工具" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvToolsLabelA"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="权限相关"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/groupA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp">

                    <LinearLayout
                        android:id="@+id/rowTut"
                        style="@style/HomeRow">

                        <FrameLayout
                            android:id="@+id/chip_tut"
                            style="@style/HomeChipIcon">

                            <ImageView
                                android:id="@+id/ic_tut"
                                style="@style/HomeChipGlyph"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_home_camera" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTutTitle"
                                style="@style/HomeRowTitle"
                                android:text="小米权限图解" />

                            <TextView
                                android:id="@+id/tvTutSub"
                                style="@style/HomeRowSub"
                                android:text="3 步完成设置，点击查看图解" />
                        </LinearLayout>

                        <ImageView
                            style="@style/HomeChev"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_chev"
                        android:tag="chev" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvToolsLabelB"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="其他设置"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/groupB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp">

                    <LinearLayout
                        android:id="@+id/rowApiSettings"
                        style="@style/HomeRow">

                        <FrameLayout
                            android:id="@+id/chip_aset"
                            style="@style/HomeChipIcon">

                            <ImageView
                                android:id="@+id/ic_aset"
                                style="@style/HomeChipGlyph"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_home_sliders" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAsetTitle"
                                style="@style/HomeRowTitle"
                                android:text="自定义选项" />

                            <TextView
                                android:id="@+id/tvAsetSub"
                                style="@style/HomeRowSub"
                                android:text="翻译行为、界面显示等个性化设置" />
                        </LinearLayout>

                        <ImageView
                            style="@style/HomeChev"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_chev"
                        android:tag="chev" />
                    </LinearLayout>

                    <View
                        android:id="@+id/divTools1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="45dp" />

                    <LinearLayout
                        android:id="@+id/rowHistory"
                        style="@style/HomeRow">

                        <FrameLayout
                            android:id="@+id/chip_hist"
                            style="@style/HomeChipIcon">

                            <ImageView
                                android:id="@+id/ic_hist"
                                style="@style/HomeChipGlyph"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_home_clock" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHistTitle"
                                style="@style/HomeRowTitle"
                                android:text="最近翻译" />

                            <TextView
                                android:id="@+id/tvHistSub"
                                style="@style/HomeRowSub"
                                android:text="查看历史记录，快速复用" />
                        </LinearLayout>

                        <ImageView
                            style="@style/HomeChev"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_chev"
                        android:tag="chev" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ======== 卡片4：使用方法 ======== -->
            <LinearLayout
                android:id="@+id/cardUsage"
                style="@style/HomeCard">

                <LinearLayout style="@style/HomeCardHead">

                    <FrameLayout
                        android:id="@+id/chip_use"
                        style="@style/HomeChipIcon">

                        <ImageView
                            android:id="@+id/ic_use"
                            style="@style/HomeChipGlyph"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_book" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvUseTitle"
                        style="@style/HomeCardTitle"
                        android:layout_marginStart="10dp"
                        android:text="使用方法" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUsage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="· 单击悬浮球 = 抓取当前屏幕文字，立即流式翻译&#10;· 翻译中再点击 = 忽略（一次只跑第一次的反应）&#10;· 内容没变时点击 = 秒回，不发请求&#10;· 持续增长的内容（如模型思考）= 自动增量翻译&#10;· 开启自启动 = 可以避免每次打开软件时的 10 秒无障碍服务验证等待"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 签名（保留） -->
            <TextView
                android:id="@+id/tvSign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="✦ glm5.3flash(๑ت๑) · 为极速而生的闪译&#10;deepseek-v4.1-flash-expires-on-0910 ∠( ᐛ 」∠)_"
                android:textSize="10.5sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
