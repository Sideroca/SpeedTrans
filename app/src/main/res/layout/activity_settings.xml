<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#0A0D12">

    <!-- 页面壁纸：纯装饰底层，零交互 -->
    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/wpScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 氛围层：扫描线 + 暗角（皮肤参数控制显隐） -->
    <com.speedtrans.app.ui.ScanlineView
        android:id="@+id/fxScanlines"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 扫描光束：只在屏幕下方 ~35% 高度带内活动 -->
    <com.speedtrans.app.ui.BeamView
        android:id="@+id/fxBeam"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="260dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="24dp"
            android:paddingRight="20dp">

            <TextView
                android:id="@+id/tvShellTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:text="设 置"
                android:textColor="#1EA5C7"
                android:textSize="28sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/titleLine"
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginTop="8dp"
                android:background="#1EA5C7" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- ===== 页：接口 ===== -->
            <LinearLayout
                android:id="@+id/pageApi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔌 智能接口"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="支持任意 OpenAI 兼容服务。选服务商自动填地址与型号；也可以全部手填，接口地址须精确到 /chat/completions 结尾。"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🛰 服务商"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.speedtrans.app.ui.BurnAutoCompleteTextView
                    android:id="@+id/acProvider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:completionThreshold="1"
                    android:hint="输入名称（如 deepseek）或点选候选"
                    android:inputType="text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvProviderNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="11sp" />

                <com.speedtrans.app.ui.BurnAutoCompleteTextView
                    android:id="@+id/etUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:completionThreshold="3"
                    android:hint="接口地址（完整 URL）"
                    android:inputType="textUri"
                    android:textSize="13sp" />

                <com.speedtrans.app.ui.BurnEditText
                    android:id="@+id/etKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="API Key"
                    android:inputType="text"
                    android:textSize="13sp" />

                <com.speedtrans.app.ui.BurnAutoCompleteTextView
                    android:id="@+id/etModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="1"
                    android:hint="模型名（可自由输入）"
                    android:inputType="text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="⚙️ 高级参数（留空即默认）"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="最大输出 Tokens（0 = 不发送；默认 8192，长文翻译不被截断）"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etMaxTokens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:inputType="number"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="温度（-1 = 不发送；0~2，翻译建议 0.2~0.5，默认 0.3）"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:inputType="numberDecimal|numberSigned"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvThinkingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🧠 思考档位"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/tierRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:textSize="11sp"
                        android:text="⚡ 测试连接" />

                    <com.speedtrans.app.ui.CircuitLampView
                        android:id="@+id/lampTest"
                        android:layout_width="110dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPromptLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="✍️ 自定义翻译提示词（留空使用默认；qwen-mt 模型作为领域提示生效）"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:hint="例：技术文档风格翻译，保留英文专有名词，不要解释。"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ===== 页：主题 ===== -->
            <LinearLayout
                android:id="@+id/pageTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 主题撞色"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="每套主题自带撞色条（色卡顶部那条），点击卡片即换装"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/themeCatRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipModern"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_bg"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="现代经典"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipChinese"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/card_bg"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="🏮 中国传统色"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/themeCardRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

<!-- ===== 页：悬浮球与面板 ===== -->
            <LinearLayout
                android:id="@+id/pageBall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ 悬浮球外观"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etBallText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="球上文字，如：译 / A / 中"
                    android:inputType="text"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="颜色"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/colorRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <RadioGroup
                    android:id="@+id/rgShapeRow1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbCircle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="圆形" />

                    <RadioButton
                        android:id="@+id/rbRounded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="圆角方形" />

                    <RadioButton
                        android:id="@+id/rbCut"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="切角八边形" />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/rgShapeRow2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbTriangle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="三角形" />

                    <RadioButton
                        android:id="@+id/rbRect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="长方形（竖）" />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/rgSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="小" />

                    <RadioButton
                        android:id="@+id/rbMid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="标准" />

                    <RadioButton
                        android:id="@+id/rbBig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="大" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnPickImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="从相册选择悬浮球图片" />

                <Button
                    android:id="@+id/btnClearImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="恢复文字球" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="🔀 翻译模式（三选一，与通知栏按钮同步）"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbModeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📄 仅文本（无障碍取词，原文零误差）" />

                    <RadioButton
                        android:id="@+id/rbModeOcr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖼 仅识图（静默截屏，全屏 100% 识别）" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="🌐 识别语言（勾选启用，未勾零开销）"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbLangLatin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="拉丁系（英/法/德/西/波/葡/意…）" />

                <CheckBox
                    android:id="@+id/cbLangChinese"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="中文（简繁）" />

                <CheckBox
                    android:id="@+id/cbLangJapanese"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="日文" />

                <CheckBox
                    android:id="@+id/cbLangKorean"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="韩文" />

                <CheckBox
                    android:id="@+id/cbLangDevanagari"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="天城文（印地语系）" />



                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="单次翻译原文上限（超出截断）"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/sbMaxChars"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="46"
                        android:progress="8" />

                    <TextView
                        android:id="@+id/tvMaxCharsVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="52dp"
                        android:text="12k字"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="📐 译文面板"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="面板高度（占屏幕比例）"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/sbHeight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="70"
                        android:progress="50" />

                    <TextView
                        android:id="@+id/tvHeightVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:text="80%"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="译文文字大小"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/sbTextSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="12"
                        android:progress="4" />

                    <TextView
                        android:id="@+id/tvTextSizeVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:text="16sp"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="✕ 关闭按钮位置"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgBtnSide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbSideLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="左侧" />

                    <RadioButton
                        android:id="@+id/rbSideRight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="右侧（推荐）" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="显示的按钮"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/swShowCopy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="显示「复制」按钮" />

                <Switch
                    android:id="@+id/swShowClose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="显示「✕ 关闭」按钮" />

                <Switch
                    android:id="@+id/swAccumulate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="译文累积（面板不关时，新译文追加在下方）" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="标题栏按钮距面板边缘"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/sbBtnPad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="24"
                        android:progress="8" />

                    <TextView
                        android:id="@+id/tvBtnPadVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="48dp"
                        android:text="8dp"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="🎨 撞色条颜色（译文面板标题条，独立于主题）"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/barRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="悬浮页面板按钮大小"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/rgBtnSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbBtnSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="小" />

                    <RadioButton
                        android:id="@+id/rbBtnMid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="标准" />

                    <RadioButton
                        android:id="@+id/rbBtnBig"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="大" />
                </RadioGroup>
            </LinearLayout>

            <!-- ===== 页：桌面 ===== -->
            <LinearLayout
                android:id="@+id/pageDesktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🖼 App 图标与桌面入口"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎨 快捷图标工坊"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="样式 → 背景色 → 图案色（44 色库），预览满意后创建到桌面。"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/ivStudioPreview"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="图标预览" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="样式"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/studioStyleRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="背景颜色"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/studioBgRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <Button
                    android:id="@+id/btnPinStudio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="创建桌面入口" />

                <Button
                    android:id="@+id/btnAliasCycle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🔀 切换桌面图标" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="或用你自己的图片 + 名字，在桌面创建一个独立入口（原应用图标可拖进文件夹隐藏）："
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etShortcutName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="桌面入口名称"
                    android:inputType="text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnPinShortcut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选图并创建桌面入口" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="若点「创建」后没有弹窗：系统设置 → 应用管理 → 闪译 → 权限管理 → 「桌面快捷方式」→ 允许，再试一次。"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ===== 页：其他 ===== -->
            <LinearLayout
                android:id="@+id/pageMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="🎨 设置页皮肤"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="导航骨架固定，换的是配色、形状与氛围。「跟随主界面主题」= 22 套配色穿控制台骨架。"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/skinRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="🖼 页面壁纸"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="设置页与主界面的装饰底层。壁纸零交互，触摸全部落在 UI 上；译文面板不参与。"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPickWallpaper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:textSize="11sp"
                        android:text="选图" />

                    <Button
                        android:id="@+id/btnClearWallpaper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:textSize="11sp"
                        android:text="清除" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swWallSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="应用到设置页" />

                <Switch
                    android:id="@+id/swWallMain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="应用到主界面" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="遮罩浓度（越高文字越清楚，壁纸越淡）"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/sbWallDim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="80"
                    android:progress="50" />

                <TextView
                    android:id="@+id/tvWallDimVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50%"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="📖 使用说明"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvUsage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="14dp"
                    android:text="使用方法：\n· 单击悬浮球 = 抓取当前屏幕文字，立即流式翻译\n· 翻译中再点球 = 忽略（一次只跑第一次的反应）\n· 按住拖动 = 移动悬浮球\n· 内容没变时点球 = 秒回，不发请求\n· 持续增长的内容（如模型思考）：自动增量翻译\n· 译文面板打开时按返回键 = 关闭面板\n\n小米/MIUI 防杀后台（一次性设置，做了就不用再管）：\n1. 最近任务长按本应用卡片 → 锁定\n2. 应用详情 → 省电策略 → 无限制\n3. 应用详情 → 自启动 → 开启\n\n日常无需打开本应用，点球即用。"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/cardContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🐧 开发者联系"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="QQ：2093523014（邮箱同号）\n点一下复制"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="✦ glm5.3flash(๑ت๑) · 为极速而生的闪译"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="40dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/cuffBar"
            android:layout_width="match_parent"
            android:layout_height="118dp">

            <com.speedtrans.app.ui.ArcView
                android:layout_width="280dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal|bottom" />

            <LinearLayout
                android:id="@+id/cuffRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_horizontal|bottom"
                android:orientation="horizontal" />
        </FrameLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="20dp"
            android:text="保存全部设置" />
    </LinearLayout>
</FrameLayout>
