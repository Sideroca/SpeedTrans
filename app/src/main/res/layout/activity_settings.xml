<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="翻译接口配置"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="填写任意 OpenAI 兼容接口。常用示例（接口地址 = 服务商地址 + /chat/completions）：\n\n千问·DashScope：\nhttps://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions\n\nDeepSeek：\nhttps://api.deepseek.com/chat/completions"
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="接口地址（完整 URL）"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://.../v1/chat/completions"
            android:inputType="textUri"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="API Key"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:inputType="text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="模型名（追求首字延迟选小快模型）"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="qwen-mt-flash / qwen-mt-lite / deepseek-chat"
            android:inputType="text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="保存" />
    </LinearLayout>
</ScrollView>
